{
  "name": "@surplus/contracts.fee-hook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "contracts/fee-hook/src",
  "projectType": "application",
  "tags": [
    "type:contracts",
    "scope:contracts"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge build --deny warnings",
        "cwd": "contracts/fee-hook",
        "forwardAllArgs": false
      },
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/test/**/*.sol",
        "{projectRoot}/script/**/*.sol",
        "{projectRoot}/foundry.toml",
        "{projectRoot}/remappings.txt"
      ],
      "outputs": [
        "{projectRoot}/out"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge test --no-match-path 'test/fork/*'",
        "cwd": "contracts/fee-hook",
        "forwardAllArgs": false
      },
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/test/**/*.sol",
        "{projectRoot}/script/**/*.sol",
        "{projectRoot}/foundry.toml",
        "{projectRoot}/remappings.txt"
      ]
    },
    "fork": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "forge test --match-path 'test/fork/*' --fork-url ${FORK_URL:-http://127.0.0.1:18549} --fork-block-number ${FORK_BLOCK:-51935583}",
        "cwd": "contracts/fee-hook",
        "forwardAllArgs": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge fmt --check",
        "cwd": "contracts/fee-hook",
        "forwardAllArgs": false
      },
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/test/**/*.sol",
        "{projectRoot}/script/**/*.sol"
      ]
    },
    "fmt": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "forge fmt",
        "cwd": "contracts/fee-hook"
      }
    },
    "gas": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "forge test --gas-report --no-match-path 'test/fork/*'",
        "cwd": "contracts/fee-hook"
      }
    },
    "mine-salt": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "forge script script/MineHookSalt.s.sol --tc MineHookSalt",
        "cwd": "contracts/fee-hook"
      }
    },
    "fuzz": {
      "executor": "nx:run-commands",
      "options": {
        "command": "FOUNDRY_PROFILE=deep forge test --no-match-path 'test/fork/*'",
        "cwd": "contracts/fee-hook",
        "forwardAllArgs": false
      },
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/test/**/*.sol",
        "{projectRoot}/foundry.toml"
      ]
    }
  }
}
{
  "name": "@surplus/contracts.token-v2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "contracts/token-v2/src",
  "projectType": "application",
  "tags": [
    "type:contracts",
    "scope:contracts"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3.14 -B scripts/sepolia_source.py --check && forge build --deny warnings",
        "cwd": "contracts/token-v2",
        "forwardAllArgs": false
      },
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/foundry.toml",
        "{projectRoot}/remappings.txt",
        "{projectRoot}/project.json",
        "{projectRoot}/script/**/*.sol",
        "{projectRoot}/scripts/**/*.py",
        "{projectRoot}/__tests__/**/*.py",
        "{projectRoot}/storage-layout.json"
      ],
      "outputs": [
        "{projectRoot}/out"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3.14 -B scripts/sepolia_source.py --check && forge test && python3.14 -B -m unittest discover -s __tests__ -p 'test_*.py' -v",
        "cwd": "contracts/token-v2",
        "forwardAllArgs": false
      },
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/test/**/*.sol",
        "{projectRoot}/foundry.toml",
        "{projectRoot}/remappings.txt",
        "{projectRoot}/project.json",
        "{projectRoot}/script/**/*.sol",
        "{projectRoot}/scripts/**/*.py",
        "{projectRoot}/__tests__/**/*.py",
        "{projectRoot}/storage-layout.json"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3.14 -B scripts/sepolia_source.py --check && forge fmt --check",
        "cwd": "contracts/token-v2",
        "forwardAllArgs": false
      },
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/test/**/*.sol",
        "{projectRoot}/project.json",
        "{projectRoot}/script/**/*.sol",
        "{projectRoot}/scripts/**/*.py",
        "{projectRoot}/__tests__/**/*.py",
        "{projectRoot}/storage-layout.json"
      ]
    },
    "layout": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/check-storage-layout.sh",
        "cwd": "contracts/token-v2",
        "forwardAllArgs": false
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "forge fmt",
        "cwd": "contracts/token-v2"
      }
    },
    "gas": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "forge test --gas-report",
        "cwd": "contracts/token-v2"
      }
    },
    "fuzz": {
      "executor": "nx:run-commands",
      "options": {
        "command": "FOUNDRY_PROFILE=deep forge test",
        "cwd": "contracts/token-v2",
        "forwardAllArgs": false
      },
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/test/**/*.sol",
        "{projectRoot}/foundry.toml"
      ]
    }
  }
}
